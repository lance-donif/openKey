{
  "name": "openkey",
  "version": "0.1.13",
  "private": true,
  "scripts": {
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,html,css}\" \"tests/**/*.js\" \"*.json\" eslint.config.js .prettierrc",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\" \"tests/**/*.js\" \"*.json\" eslint.config.js .prettierrc",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0"
  }
}
